
# Source: LizardByte
# Site: https://app.lizardbyte.dev/support
# Repository: LizardByte / stable
# Description: Stable releases for LizardByte projects.

[lizardbyte-stable]
name=lizardbyte-stable
baseurl=https://dl.cloudsmith.io/public/lizardbyte/stable/rpm/fedora/$releasever/$basearch
repo_gpgcheck=1
enabled=1
skip_if_unavailable=1
gpgkey=file:///etc/pki/rpm-gpg/lizardbyte-stable.asc
gpgcheck=1
sslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt
metadata_expire=300
type=rpm-md


[lizardbyte-stable-source]
name=lizardbyte-stable-source
baseurl=https://dl.cloudsmith.io/public/lizardbyte/stable/rpm/fedora/$releasever/SRPMS
repo_gpgcheck=1
enabled=1
skip_if_unavailable=1
gpgkey=file:///etc/pki/rpm-gpg/lizardbyte-stable.asc
gpgcheck=1
sslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt
metadata_expire=300
type=rpm-md
