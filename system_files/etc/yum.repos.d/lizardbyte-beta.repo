# Source: LizardByte Cloudsmith beta (pre-releases)
# https://cloudsmith.io/~lizardbyte/repos/beta/

[lizardbyte-beta]
name=lizardbyte-beta
baseurl=https://dl.cloudsmith.io/public/lizardbyte/beta/rpm/fedora/$releasever/$basearch
repo_gpgcheck=1
enabled=1
skip_if_unavailable=1
gpgkey=file:///etc/pki/rpm-gpg/lizardbyte-beta.asc
gpgcheck=1
sslverify=1
metadata_expire=300
type=rpm-md

[lizardbyte-beta-source]
name=lizardbyte-beta-source
baseurl=https://dl.cloudsmith.io/public/lizardbyte/beta/rpm/fedora/$releasever/SRPMS
repo_gpgcheck=1
enabled=0
skip_if_unavailable=1
gpgkey=file:///etc/pki/rpm-gpg/lizardbyte-beta.asc
gpgcheck=1
sslverify=1
metadata_expire=300
type=rpm-md
